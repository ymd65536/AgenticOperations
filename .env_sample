AZURE_ENDPOINT=https://your-azure-endpoint.com
AZURE_API_KEY=your_azure_api_key_here
AZURE_DEPLOYMENT_NAME=gpt-4o
AZURE_API_VERSION=2024-10-21
AZURE_SUBSCRIPTION_ID=your_subscription_id_here
AZURE_RESOURCE_GROUP=your_resource_group_here
AZURE_PROJECT_NAME=your_project_name_here
AZURE_AI_PROJECT=your_azure_ai_project_url_here

# Hosted Agent outbound probe path.
# This is the safe network egress path used by the agent when direct public-IP HTTP probing is blocked.
HTTP_PROBE_ENDPOINT=http://127.0.0.1:8081/probe

# Runtime VM IP is resolved from .state/vm-nginx-404.env and should not be hardcoded in the code.
VM_PUBLIC_IP=
